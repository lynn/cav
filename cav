#!/bin/bash

# cavendi.sh

set -e
version="0.1.0"
cavendish="🍌⚡"
debugging=0

declare -A mod_desc
declare -A mod_url

mod_desc["Pampa"]='Adds 28 jokers by Pampa'
mod_url["Pampa"]='https://github.com/batabata3/balatro-pampa-joker-pack.git'

mod_desc["CardSleeves"]='Adds sleeves as modifiers to decks'
mod_url["CardSleeves"]='https://github.com/larswijn/CardSleeves.git'

mod_desc["paperback"]='Expands the base game in many ways'
mod_url["paperback"]='https://github.com/Balatro-Paperback/paperback.git'

mod_desc["Cryptid"]='An unbalanced mod'
mod_url["Cryptid"]='https://github.com/SpectralPack/Cryptid.git'

mod_desc["ExtraCredit"]='A small-scale vanilla-style content mod'
mod_url["ExtraCredit"]='https://github.com/GuilloryCraft/ExtraCredit.git'

mod_desc["CozyStats"]='Stats'
mod_url["CozyStats"]='https://github.com/NoxZet/CozyStats'

warn() { echo "${WARN}  !${NORMAL} $*" >&2; }
error() { echo "${RED}  X${NORMAL} $*" >&2; }
die() { error "$*" && exit 1; }
debug() { if [ $debugging -eq 1 ]; then echo "${GREEN}  =${NORMAL} $*" >&2; fi; }

for cmd in curl unzip perl tput find grep; do
    if ! command -v "$cmd" > /dev/null; then
        die "$cmd is not installed."
    fi
done

GREEN=$(tput setaf 2 && tput bold)
RED=$(tput setaf 1 && tput bold)
HIGHLIGHT=$(tput setaf 3 && tput bold)
HINT=$(tput setaf 6)
WARN=$(tput setaf 3 && tput bold)
DIM=$(tput dim && tput sitm)
NORMAL=$(tput sgr0)

ask() {
    echo -n "$1${HINT}" >&2
    read -r answer
    echo -n "${NORMAL}" >&2
    echo "$answer"
}

confirm() {
    answer=$(ask "$1 (y/N) ")
    [[ "$answer" =~ ^[Yy]$ ]]
}

steam_running() {
    pgrep '^steam$|^steamwebhelper$' > /dev/null
}

kill_steam() {
    if steam_running; then
        confirm "Steam is running. Shall I run ${HINT}pkill -x '^steam$|^steamwebhelper$'${NORMAL} to kill it?"
        pkill -x '^steam$|^steamwebhelper$'
        echo -n "Waiting for Steam to exit."
        while steam_running; do sleep 0.5; echo -n "."; done
        echo ""
    fi
}

find_balatro() {
    local steam_roots=(
        ~/.local/share/Steam
        ~/.var/app/com.valvesoftware.Steam/.local/share/Steam
        ~/snap/steam/common/.local/share/Steam
        ~/.steam/steam
    )

    for dir in "${steam_roots[@]}"; do
        if [ -d "$dir" ]; then steam_root="$dir"; break; fi
    done

    if [ -z "$steam_root" ]; then
        die "No Steam installation found in known locations."
    fi

    balatro_path="$steam_root/steamapps/common/Balatro"
    if [ ! -d "$balatro_path" ]; then
        die "Balatro directory not found at $balatro_path"
    fi

    if [ -z "$BALATRO_MODS" ]; then
        balatro_appdata_path="$steam_root/steamapps/compatdata/2379780/pfx/drive_c/users/steamuser/AppData/Roaming/Balatro/"
        if [ ! -d "$balatro_appdata_path" ]; then
            die "Balatro appdata directory not found at $balatro_appdata_path"
        fi
        export BALATRO_MODS="${balatro_appdata_path%/}/Mods"
    else
        balatro_appdata_path="${BALATRO_MODS%/Mods}"
        debug "Got balatro_appdata_path from BALATRO_MODS: ${HINT}$balatro_appdata_path${NORMAL}"
    fi

    balatro_mods="${balatro_appdata_path%/}/Mods"

    if ! [ -f "$balatro_appdata_path/settings.jkr" ]; then
        die "settings.jkr not found at ${HINT}$balatro_appdata_path/settings.jkr${NORMAL} (is Balatro installed?)"
    fi
}

find_balatro

debug "Found Balatro at $balatro_path"
debug "Found Balatro appdata at $balatro_appdata_path"

step() { echo "  ${HINT}•${NORMAL} $1"; }

is_balatro_installed() {
    [ -f "$balatro_path/Balatro.exe" ]
}

balatro_version() {
    if ! is_balatro_installed; then
        echo "${WARN}not installed${NORMAL}"
    else
        grep -aPo 'version.jkr\K.*' "$balatro_path/Balatro.exe" || echo "unknown"
    fi
}

is_lovely_installed() {
    [ -f "$balatro_path/version.dll" ]
}

lovely_version() {
    if ! is_lovely_installed; then
        echo "${WARN}not installed${NORMAL}"
    else
        grep -aPo 'lovely.{0,30}\K\d+\.\d+\.\d+(-beta\d+)?' "$balatro_path/version.dll" || echo "unknown"
    fi
}

is_steamodded_installed() {
    [ -n "$(compgen -G "$balatro_mods/Steamodded-smods-*")" ]
}

steamodded_version() {
    if ! is_steamodded_installed; then
        echo "${WARN}not installed${NORMAL}"
    else
        cat "$balatro_mods"/Steamodded-smods-*/release.lua | sed 's/return \|"\|-STEAMODDED//g;s/~BETA/-beta/g' | tr -d ' ' || echo "unknown"
    fi
}


SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

print_component() {
    local name=$1
    local version=$2
    local path=$3
    local verbose=$4

    if [ "$version" = "${WARN}not installed${NORMAL}" ]; then
        echo "  ${RED}•${NORMAL} $name: ${HINT}$version${NORMAL}"
    else
        echo "  ${GREEN}•${NORMAL} $name: ${HINT}$version${NORMAL}"
        if [ -n "$verbose" ] && [ -n "$path" ]; then
            echo "  ${DIM}└ installed at ${HINT}$path${NORMAL}"
        fi
    fi
    if [ -n "$verbose" ]; then
        echo ""
    fi
}

status() {
    local verbose=$1
    echo ""
    print_component "cav" "$version" "$SCRIPT_DIR" "$verbose"
    print_component "Balatro" "$(balatro_version)" "$balatro_path" "$verbose"
    print_component "Lovely" "$(lovely_version)" "$balatro_path/version.dll" "$verbose"

    local steamodded_path=$(compgen -G "$balatro_mods/Steamodded-smods-*" | head -n 1)
    print_component "Steamodded" "$(steamodded_version)" "$steamodded_path" "$verbose"
}

list_versions() {
    local repo=$1
    local current_version=$2

    curl -sL "https://api.github.com/repos/$repo/releases" | \
        grep -E '"tag_name"|"published_at"' | \
        paste -d ' ' - - | \
        sed -E 's/.*"tag_name": "([^"]+)".*"published_at": "([^T]+)T.*/\1 \2/' | \
        while read -r version date; do
            if [ "$version" = "$current_version" ]; then
                printf "  ${HIGHLIGHT}» %-16s${NORMAL} ${DIM}(%s)${NORMAL}\n" "$version" "$date"
            else
                printf "  %-16s ${DIM}(%s)${NORMAL}\n" "$version" "$date"
            fi
        done
}

list_lovely() {
    echo ""
    echo "${HINT}Available Lovely versions:${NORMAL}"
    echo ""
    list_versions "ethangreen-dev/lovely-injector" "v$(lovely_version)"
    echo ""
}

list_steamodded() {
    echo ""
    echo "${HINT}Available Steamodded versions:${NORMAL}"
    echo ""
    list_versions "Steamodded/smods" "$(steamodded_version)"
    echo ""
}

list_mods() {
    echo "Available mods:"
    echo ""
    for mod in "${!mod_desc[@]}"; do
        status=$(if [ -d "$balatro_mods/$mod}" ]; then echo "[${GREEN}•${NORMAL}]"; else echo "[ ]"; fi)
        printf "  $status ${HINT}%-16s${NORMAL} ${mod_desc[$mod]}\n" "$mod"
    done
    echo ""
    echo "Run ${HINT}cav add <mod>${NORMAL} to install a mod."
}

install_lovely() {
    step "Downloading Lovely..."
    lovely_url=$(curl -sL https://api.github.com/repos/ethangreen-dev/lovely-injector/releases/latest | grep -m1 -Eo 'https://[^#]+windows-msvc.zip' )
    step "Lovely URL: ${HINT}$lovely_url${NORMAL}"
    curl -sL "$lovely_url" > lovely.zip
    unzip -oq lovely.zip
    rm lovely.zip

    # This somewhat hacky Perl script looks for Balatro in localconfig.vdf, removes any
    # existing LaunchOptions line, and adds a new one with the correct value.
    perl -ne '
        $tabs = $` if /"2379780"$/;
        if (/^$tabs"2379780"$/ .. /^$tabs\}$/) {
            print qq($tabs\t"LaunchOptions"		"WINEDLLOVERRIDES=version=n,b %command%"\n) if /^$tabs\}$/;
            print unless /"LaunchOptions"/;
        } else { print; }
    ' "$localconfig_path" > "$localconfig_path.tmp"

    if [ -n "$(diff "$localconfig_path" "$localconfig_path.tmp")" ]; then
        echo "Updating Balatro Steam launch options"
        mv "$localconfig_path.tmp" "$localconfig_path"
    else
        rm "$localconfig_path.tmp"
    fi

    step "Installing Lovely (version.dll)..."
    mv version.dll "$balatro_path/version.dll"
}

install_steamodded() {
    step "Downloading Steamodded..."
    smod_url=$(curl -sL https://api.github.com/repos/Steamodded/smods/releases/latest | grep -Eo 'https://.*zipball/[^"]+')
    step "Steamodded URL: ${HINT}$smod_url${NORMAL}"
    curl -sL "$smod_url" > smod.zip
    unzip -oq smod.zip
    rm smod.zip

    step "Installing Steamodded..."
    mkdir -p "$balatro_appdata_path/Mods"
    cp -r Steamodded-* "$balatro_appdata_path/Mods/"
    rm -r Steamodded-*
}

install() {
    local component=$1

    case "$component" in
        lovely)
            kill_steam
            localconfig_path=$(compgen -G "$steam_root/userdata/*/config/localconfig.vdf" | head -n 1)
            install_lovely
            echo ""
            echo "Done! $cavendish"
            status
            ;;
        steamodded)
            # Remove existing Steamodded if present
            if compgen -G "$BALATRO_MODS/Steamodded-smods*" > /dev/null; then
                kill_steam
                warn "Removing existing Steamodded installation..."
                rm -rf "$BALATRO_MODS"/Steamodded-smods-*
            else
                kill_steam
            fi
            install_steamodded
            echo ""
            echo "Done! $cavendish"
            status
            ;;
        "")
            if compgen -G "$BALATRO_MODS/Steamodded-smods*" > /dev/null; then
                error "Steamodded is already installed."
                die "To reinstall, please run ${HINT}cav uninstall${NORMAL} first, or use ${HINT}cav install steamodded${NORMAL} to force-reinstall."
            fi

            kill_steam
            localconfig_path=$(compgen -G "$steam_root/userdata/*/config/localconfig.vdf" | head -n 1)

            install_lovely
            install_steamodded

            echo ""
            echo "Done! $cavendish"
            status
            echo ""
            echo "You may find it useful to add these lines to your shell config:"
            echo ""
            echo "${HINT}export BALATRO_PATH=\"${balatro_path}\"${NORMAL}"
            echo "${HINT}export BALATRO_MODS=\"${balatro_appdata_path%/}/Mods\"${NORMAL}"
            ;;
        *)
            die "Unknown component: ${HINT}$component${NORMAL}. Use 'lovely' or 'steamodded'."
            ;;
    esac
}

uninstall() {
    delenda=$(find "$BALATRO_MODS/" -maxdepth 1 -name "Steamodded-smods-*" -type d | sort)
    if [ -n "$delenda" ]; then
        kill_steam
        warn "Uninstalling Steamodded, or installing a new version, may cause in-progress runs to crash."
        echo ""
        echo "I can uninstall Steamodded and Lovely using these commands:"
        echo ""
        while IFS= read -r path; do
            echo "  ${HINT}rm -r \"${path}\"${NORMAL}"
        done <<< "$delenda"
        echo "  ${HINT}rm \"$balatro_path/version.dll\"${NORMAL}"
        echo ""
        confirm "Shall I run these commands?" || die "Aborting."
        while IFS= read -r path; do
            rm -r "$path"
        done <<< "$delenda"
        rm "$balatro_path/version.dll"
        echo "Done! $cavendish"
    else
        echo "Nothing to uninstall in ${HINT}$BALATRO_MODS${NORMAL}."
        exit 1
    fi
}

pascal_case() {
    echo "$1" | iconv -t ascii//TRANSLIT | tr -d "'" | sed -r s/[^a-zA-Z0-9]+/-/g | sed -r s/^-+\|-+$//g | tr '[:upper:]' '[:lower:]' | sed -r 's/(^|-)([a-z])/\U\2/g'
}

random_adjective() {
    local adjectives=( "Cool" "Weird" "Bonus" "Fruity" "Fast" "Slow" "Sweet" "Tangy" "Spicy" "Silver" "Merry" "Droll" "Jolly" "Lucky" "Thrifty" "Risky" "Hyper" "Quantum" "Secret" "Fiery" "Glass" "Polychrome" "Holographic" "Stone" "Red" "Blue" "Yellow" "Green" )
    echo "${adjectives[$RANDOM % ${#adjectives[@]}]}"
}

random_noun() {
    local nouns=( "Clubs" "Diamonds" "Hearts" "Spades" "Joker" "Aces" "Kings" "Queens" "Jacks" "Deck" "Blind" "Straight" "Flush" "Planet" "Tarot" "Money" "Reroll" "Card" "Shop" "Jimbo" "Pair" "Sevens" "Eights" "Nines" )
    echo "${nouns[$RANDOM % ${#nouns[@]}]}"
}

get_mod() {
    local mod_name=$1

    if [ -z "$mod_name" ]; then
        die "Please specify a mod name. Run ${HINT}cav mods${NORMAL} to see available mods."
    fi

    if [ -z "${mod_url[$mod_name]}" ]; then
        die "Unknown mod: ${HINT}$mod_name${NORMAL}. Run ${HINT}cav mods${NORMAL} to see available mods."
    fi

    if [ -d "$balatro_mods/$mod_name}" ]; then
        die "Mod ${HINT}$mod_name${NORMAL} is already installed."
        # confirm "Do you want to reinstall it?" || die "Aborting."
        # kill_steam
        # rm -rf "$balatro_mods/${mod_path[$mod_name]}"
    else
        kill_steam
    fi

    git clone "${mod_url[$mod_name]}" "$balatro_mods/$mod_name"
    echo ""
    echo "Done! $cavendish"
    echo "Installed ${HINT}$mod_name${NORMAL}"
}

create_project() {
    name="$(random_adjective) $(random_noun)"
    custom_name=$(ask "Enter a name for your mod: ${DIM}(how about $name?)${NORMAL} ")
    if [ -n "$custom_name" ]; then
        name="$custom_name"
    fi
    folder_name=$(pascal_case "$name")
    custom_folder_name=$(ask "Enter a folder name: ${DIM}(default: $folder_name)${NORMAL} ")
    if [ -n "$custom_folder_name" ]; then
        folder_name="$custom_folder_name"
    fi
    mod_path="${balatro_appdata_path%/}/Mods/$folder_name"
    short_mod_path=${mod_path/$BALATRO_MODS/\$BALATRO_MODS}
    if [ -d "$mod_path" ]; then
        echo "Error: Project directory already exists at ${HINT}$short_mod_path${NORMAL}" >&2
        echo "Please choose a different name or delete the existing project." >&2
        exit 1
    fi
    mkdir -p "$mod_path"
    echo "--- STEAMODDED HEADER
--- MOD_NAME: $name
--- MOD_ID: $folder_name
--- MOD_AUTHOR: [$(whoami)]
--- MOD_DESCRIPTION: Describe your mod here
--- DEPENDENCIES: [Steamodded>=1.0.0~BETA-0301a]

----------------------------------------------
------------MOD CODE -------------------------

-- See https://github.com/Steamodded/examples/tree/master/Mods for examples.

SMODS.Back{
    name = \"Example Deck\",
    key = \"example\",
    pos = {x = 0, y = 3},
    config = {},
    loc_txt = { name = \"Example Deck\", text = {\"If you see this,\", \"your mod is working!\"} },
    apply = function()
        G.E_MANAGER:add_event(Event({
            func = function()
                for i = #G.playing_cards, 1, -1 do
                    G.playing_cards[i]:set_ability(G.P_CENTERS.m_glass)
                end
                return true
            end
        }))
    end
}

----------------------------------------------
------------MOD CODE END----------------------" >"$mod_path/$folder_name.lua"

    echo ""
    echo "Created project ${HINT}$name${NORMAL} at ${HINT}$short_mod_path${NORMAL}"
    echo "You can now start developing your mod by editing the files in this directory."
    echo ""
    echo "  ${HINT}cd $short_mod_path${NORMAL}"
    echo "  ${HINT}${EDITOR:-vim} $folder_name.lua${NORMAL}"
    echo ""
    echo "You should already see your mod if you launch Balatro now."
    echo "Hold ${HINT}M${NORMAL} in-game to reload mods. Happy modding!"
}

usage() {
    echo "" >&2
    echo "  ${HINT}cav install              ${NORMAL}Install the latest version of Lovely and Steamodded." >&2
    echo "  ${HINT}cav install lovely       ${NORMAL}Force-reinstall the latest version of Lovely." >&2
    echo "  ${HINT}cav install steamodded   ${NORMAL}Force-reinstall the latest version of Steamodded." >&2
    echo "  ${HINT}cav status               ${NORMAL}Show installed versions." >&2
    echo "  ${HINT}cav list lovely          ${NORMAL}List available versions of Lovely." >&2
    echo "  ${HINT}cav list steamodded      ${NORMAL}List available versions of Steamodded." >&2
    echo "  ${HINT}cav mods                 ${NORMAL}List available mods." >&2
    echo "  ${HINT}cav get <mod>            ${NORMAL}Download a mod from the list." >&2
    echo "  ${HINT}cav uninstall            ${NORMAL}Uninstall Lovely and Steamodded." >&2
    echo "  ${HINT}cav new                  ${NORMAL}Create a new Balatro mod project." >&2
}

case "$1" in
    ""|"-h"|"--help")
        echo ""
        echo "  $cavendish cav $version"
        usage
        ;;
    version|-v|--version)
        echo "$version"
        ;;
    status)
        status verbose
        ;;
    list)
        case "$2" in
            lovely)
                list_lovely
                ;;
            steamodded)
                list_steamodded
                ;;
            *)
                die "'list' requires a subcommand (lovely or steamodded)"
                ;;
        esac
        ;;
    install)
        install "$2"
        ;;
    uninstall)
        uninstall
        ;;
    new)
        create_project
        ;;
    mods)
        list_mods
        ;;
    get )
        get_mod "$2"
        ;;
    *)
        echo "Invalid command: $1" >&2
        usage
	exit 2
        ;;
esac
